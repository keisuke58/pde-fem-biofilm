! post_fields_living_early.mac -- as post_fields_living.mac at the result
! sets nearest to T* = 0, 0.025, ..., 0.25 (run time T* + 0.0025, the runs
! with the start step of 0.0025; 11 times, addendum 29: the early growth of
! the separate example at 8^3). Use after FILE,<job>,rst;
! fields_living.py RUN DIR DECK 11 reads the CSVs.
/POST1
*DIM,TT_,ARRAY,11
*VFILL,TT_(1),RAMP,0.0025,0.025
*DO,K_,1,11
  SET,,,,,TT_(K_)
  *GET,TS_,ACTIVE,0,SET,TIME
  ALLSEL
  *GET,EMAX_,ELEM,0,NUM,MAX
  ETABLE,EPHI,SVAR,41
  ETABLE,EN51,SVAR,51
  ETABLE,EN52,SVAR,52
  ETABLE,EL87,SVAR,87
  ETABLE,ES89,SVAR,89
  ETABLE,EA84,SVAR,84
  ETABLE,ESEQ,S,EQV
  ETABLE,ECX,CENT,X
  ETABLE,ECY,CENT,Y
  ETABLE,ECZ,CENT,Z
  *DEL,EID_,,NOPR
  *DEL,ET_,,NOPR
  *DEL,EPH_,,NOPR
  *DEL,EN_,,NOPR
  *DEL,EB_,,NOPR
  *DEL,EL_,,NOPR
  *DEL,ES_,,NOPR
  *DEL,EAL_,,NOPR
  *DEL,ESQ_,,NOPR
  *DEL,ECX_,,NOPR
  *DEL,ECY_,,NOPR
  *DEL,ECZ_,,NOPR
  *DIM,EID_,ARRAY,EMAX_
  *DIM,ET_,ARRAY,EMAX_
  *DIM,EPH_,ARRAY,EMAX_
  *DIM,EN_,ARRAY,EMAX_
  *DIM,EB_,ARRAY,EMAX_
  *DIM,EL_,ARRAY,EMAX_
  *DIM,ES_,ARRAY,EMAX_
  *DIM,EAL_,ARRAY,EMAX_
  *DIM,ESQ_,ARRAY,EMAX_
  *DIM,ECX_,ARRAY,EMAX_
  *DIM,ECY_,ARRAY,EMAX_
  *DIM,ECZ_,ARRAY,EMAX_
  *VFILL,EID_(1),RAMP,1,1
  *VFILL,ET_(1),RAMP,TS_,0
  *VGET,EPH_(1),ELEM,1,ETAB,EPHI
  *VGET,EN_(1),ELEM,1,ETAB,EN51
  *VGET,EB_(1),ELEM,1,ETAB,EN52
  *VGET,EL_(1),ELEM,1,ETAB,EL87
  *VGET,ES_(1),ELEM,1,ETAB,ES89
  *VGET,EAL_(1),ELEM,1,ETAB,EA84
  *VGET,ESQ_(1),ELEM,1,ETAB,ESEQ
  *VGET,ECX_(1),ELEM,1,ETAB,ECX
  *VGET,ECY_(1),ELEM,1,ETAB,ECY
  *VGET,ECZ_(1),ELEM,1,ETAB,ECZ
  *CFOPEN,fields_%K_%,csv
  *VWRITE
('elem,t,phi,nut,ab,L,shareA,alpha,seqv,cx,cy,cz')
  *VWRITE,EID_(1),ET_(1),EPH_(1),EN_(1),EB_(1),EL_(1),ES_(1),EAL_(1),ESQ_(1),ECX_(1),ECY_(1),ECZ_(1)
(F8.0,11(',',E24.16))
  *CFCLOS
*ENDDO
FINISH

+      sLdp_SurfBeta = sLdp_BetaStar
+      cParName='SURF_BETA'
+      CALL parevl(cParName,0,0,0,dp1(1),chValue,Si_Kerr)
+      IF (Si_Kerr .EQ. 0 .AND. dp1(1) .GT. 0.0D0) sLdp_SurfBeta = dp1(1)
 
        HALF=0.5D0
  

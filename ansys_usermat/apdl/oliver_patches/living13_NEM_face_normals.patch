       cParName='WMAT_THRESHOLD'
       CALL parevl(cParName,0,0,0,dp1(1),chValue,Si_Kerr)
       sLdp_WMatThres = dp1(1)
+      sLdp_FaceNormals = 0.0D0
+      cParName='FACE_NORMALS'
+      CALL parevl(cParName,0,0,0,dp1(1),chValue,Si_Kerr)
+      IF (Si_Kerr .EQ. 0) sLdp_FaceNormals = dp1(1)
+      sLdp_FaceWeight = 1.0D0
+      cParName='FACE_WEIGHT'
+      CALL parevl(cParName,0,0,0,dp1(1),chValue,Si_Kerr)

+         mANode(sGi_NeighCnt+1,1:3) = 0.0D0
+         mWNode(sGi_NeighCnt+1,sGi_NeighCnt+1) = 0.0D0
+       END IF
  
        mAtransNode=TRANSPOSE(mANode)
        mResult1Node=MATMUL(mAtransNode,mWNode)
        mResult2Node=MATMUL(mResult1Node,mANode)
+       IF (sLdp_FaceNormals .GT. 0.5D0) THEN
+         DO Si_FaceA = 1, 3

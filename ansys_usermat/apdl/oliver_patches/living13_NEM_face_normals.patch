      &,mResult4Node(4,sGi_NeighCnt+1)
      &,mAtransNode(4,sGi_NeighCnt+1),mDNode(4,sGi_NeighCnt+1)
      &,vLdp_Normals(3)
+!     pde-fem-biofilm 24 Oct 2026 (A-69): FACE_NORMALS = 1 replaces the
+!     single constraint along the point's normal by one zero-gradient
+!     constraint per face the point lies on (an edge: two, a corner:
+!     three; faces from the non-zero components of the normal, box
+!     geometry), each with the weight FACE_WEIGHT (default 1 as before)
+      DOUBLE PRECISION sLdp_FaceNormals, sLdp_FaceWeight, sLdp_SurfBeta
+      INTEGER Si_FaceA
 
             !Define all Characters
       CHARACTER(256) :: cParName    !parameter Name from the APDL

        !      mW(ii,ii)= 1
        mWNode(ii,ii)=EXP(-0.5D0*((4.0D0*SQRT((vdxNode(ii)**2.0D0)
      & +(vdyNode(ii)**2.0D0)+(vdzNode(ii)**2.0D0)))
-     & /sLdp_BetaStar)**2.0D0)
+     & /sLdp_SurfBeta)**2.0D0)
              !Check if the value is smaller than 1.0D-8
              IF(mWNode(ii,ii) .LE. sLdp_WMatThres)THEN
                    mWNode(ii,ii)=0.0D0

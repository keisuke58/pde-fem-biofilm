! post_fields_living.mac -- as post_fields_time.mac, for the coupling with
! the living share (prop(28) = 11, A-19, 20 Oct 2026): every element at the
! result sets nearest to T* = 0.25, 0.5, 0.75, 1.0, fields_<k>.csv with elem,
! the set's time, the field phi (SVAR 41), nutrient c (SVAR 51), the second
! field a, the antibiotic (SVAR 52), the living share L (SVAR 87), the share
! of species A phi_1/(phi_1 + phi_2) (SVAR 89, 0 where the point model has
! not started), alpha - 1 (SVAR 84), SEQV, centroid x, y, z. Element means of
! the Gauss-point values. Use after FILE,<job>,rst; fields_living.py makes
! the JSON.
/POST1
*DIM,TT_,ARRAY,4
TT_(1) = 0.25
TT_(2) = 0.5
TT_(3) = 0.75
TT_(4) = 1.0
*DO,K_,1,4
  SET,,,,,TT_(K_)
  *GET,TS_,ACTIVE,0,SET,TIME
  ALLSEL
  *GET,EMAX_,ELEM,0,NUM,MAX
  ETABLE,EPHI,SVAR,41
  ETABLE,EN51,SVAR,51
  ETABLE,EN52,SVAR,52
  ETABLE,EL87,SVAR,87
  ETABLE,ES89,SVAR,89
  ETABLE,EA84,SVAR,84
  ETABLE,ESEQ,S,EQV
  ETABLE,ECX,CENT,X
  ETABLE,ECY,CENT,Y
  ETABLE,ECZ,CENT,Z
  *DEL,EID_,,NOPR
  *DEL,ET_,,NOPR
  *DEL,EPH_,,NOPR
  *DEL,EN_,,NOPR
  *DEL,EB_,,NOPR
  *DEL,EL_,,NOPR
  *DEL,ES_,,NOPR
  *DEL,EAL_,,NOPR
  *DEL,ESQ_,,NOPR
  *DEL,ECX_,,NOPR
  *DEL,ECY_,,NOPR
  *DEL,ECZ_,,NOPR
  *DIM,EID_,ARRAY,EMAX_
  *DIM,ET_,ARRAY,EMAX_
  *DIM,EPH_,ARRAY,EMAX_
  *DIM,EN_,ARRAY,EMAX_
  *DIM,EB_,ARRAY,EMAX_
  *DIM,EL_,ARRAY,EMAX_
  *DIM,ES_,ARRAY,EMAX_
  *DIM,EAL_,ARRAY,EMAX_
  *DIM,ESQ_,ARRAY,EMAX_
  *DIM,ECX_,ARRAY,EMAX_
  *DIM,ECY_,ARRAY,EMAX_
  *DIM,ECZ_,ARRAY,EMAX_
  *VFILL,EID_(1),RAMP,1,1
  *VFILL,ET_(1),RAMP,TS_,0
  *VGET,EPH_(1),ELEM,1,ETAB,EPHI
  *VGET,EN_(1),ELEM,1,ETAB,EN51
  *VGET,EB_(1),ELEM,1,ETAB,EN52
  *VGET,EL_(1),ELEM,1,ETAB,EL87
  *VGET,ES_(1),ELEM,1,ETAB,ES89
  *VGET,EAL_(1),ELEM,1,ETAB,EA84
  *VGET,ESQ_(1),ELEM,1,ETAB,ESEQ
  *VGET,ECX_(1),ELEM,1,ETAB,ECX
  *VGET,ECY_(1),ELEM,1,ETAB,ECY
  *VGET,ECZ_(1),ELEM,1,ETAB,ECZ
  *CFOPEN,fields_%K_%,csv
  *VWRITE
('elem,t,phi,nut,ab,L,shareA,alpha,seqv,cx,cy,cz')
  *VWRITE,EID_(1),ET_(1),EPH_(1),EN_(1),EB_(1),EL_(1),ES_(1),EAL_(1),ESQ_(1),ECX_(1),ECY_(1),ECZ_(1)
(F8.0,11(',',E24.16))
  *CFCLOS
*ENDDO
FINISH

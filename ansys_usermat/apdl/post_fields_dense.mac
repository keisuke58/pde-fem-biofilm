! post_fields_dense.mac -- as post_fields_time.mac, at the result sets
! nearest to T* = 0.025, 0.05, ..., 1.0 (40 times, for the animation, A-18): fields_<k>.csv with elem, the time of the
! set, the field phi at the Gauss points (SVAR 41, what the material routine
! receives, phi_used of the point-model trace), nutrient c (SVAR 51),
! alpha - 1 (SVAR 84), SEQV, centroid x, y, z. Element (centroid) values.
! Use after FILE,<job>,rst; fields_time.py collects the 40 files into JSON
! (python fields_time.py RUN DIR 40).
/POST1
*DIM,TT_,ARRAY,40
*VFILL,TT_(1),RAMP,0.025,0.025
*DO,K_,1,40
  SET,,,,,TT_(K_)
  *GET,TS_,ACTIVE,0,SET,TIME
  ALLSEL
  *GET,EMAX_,ELEM,0,NUM,MAX
  ETABLE,EPHI,SVAR,41
  ETABLE,EN51,SVAR,51
  ETABLE,EA84,SVAR,84
  ETABLE,ESEQ,S,EQV
  ETABLE,ECX,CENT,X
  ETABLE,ECY,CENT,Y
  ETABLE,ECZ,CENT,Z
  *DEL,EID_,,NOPR
  *DEL,ET_,,NOPR
  *DEL,EPH_,,NOPR
  *DEL,EN_,,NOPR
  *DEL,EAL_,,NOPR
  *DEL,ESQ_,,NOPR
  *DEL,ECX_,,NOPR
  *DEL,ECY_,,NOPR
  *DEL,ECZ_,,NOPR
  *DIM,EID_,ARRAY,EMAX_
  *DIM,ET_,ARRAY,EMAX_
  *DIM,EPH_,ARRAY,EMAX_
  *DIM,EN_,ARRAY,EMAX_
  *DIM,EAL_,ARRAY,EMAX_
  *DIM,ESQ_,ARRAY,EMAX_
  *DIM,ECX_,ARRAY,EMAX_
  *DIM,ECY_,ARRAY,EMAX_
  *DIM,ECZ_,ARRAY,EMAX_
  *VFILL,EID_(1),RAMP,1,1
  *VFILL,ET_(1),RAMP,TS_,0
  *VGET,EPH_(1),ELEM,1,ETAB,EPHI
  *VGET,EN_(1),ELEM,1,ETAB,EN51
  *VGET,EAL_(1),ELEM,1,ETAB,EA84
  *VGET,ESQ_(1),ELEM,1,ETAB,ESEQ
  *VGET,ECX_(1),ELEM,1,ETAB,ECX
  *VGET,ECY_(1),ELEM,1,ETAB,ECY
  *VGET,ECZ_(1),ELEM,1,ETAB,ECZ
  *CFOPEN,fields_%K_%,csv
  *VWRITE
('elem,t,phi,nut,alpha,seqv,cx,cy,cz')
  *VWRITE,EID_(1),ET_(1),EPH_(1),EN_(1),EAL_(1),ESQ_(1),ECX_(1),ECY_(1),ECZ_(1)
(F8.0,8(',',E24.16))
  *CFCLOS
*ENDDO
FINISH

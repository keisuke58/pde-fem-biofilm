/gst,on,on
fini
*get,_numnode,node,0,count
*get,_numelem,elem,0,count
*get, _MAXELEMNUM, elem, 0, NUM, MAX
*get, _MAXNODENUM, node, 0, NUM, MAX
*get, _MAXELEMTYPE, etyp, 0, NUM, MAX
*get, _MAXREALCONST, rcon, 0, NUM, MAX
/go
/wb,load,end               !  done creating loads
/com,--- Number of total nodes = %_numnode%
/com,--- Number of contact elements = 0
/com,--- Number of spring elements = 0
/com,--- Number of bearing elements = 0
/com,--- Number of solid elements = 512
/com,--- Number of condensed parts = 0
/com,--- Number of total elements = %_numelem%
*get,_wallbsol,active,,time,wall
/com,****************************************************************************
/com,*************************    SOLUTION       ********************************
/com,****************************************************************************
/solu
antype,0                   ! static analysis
nlgeom,on                  ! Turn on Large Deformation Effects
_thickRatio=  1     ! Ratio of thick parts in the model
eqsl,pcg,1e-8,,,,,,1
nropt,full                 ! Use full Newton-Raphson
cntr,print,1               ! print out contact info and also make no initial contact an error
nldiag,cont,iter           ! print out contact info each equilibrium iteration
rescontrol,define,last,last,,dele	   ! Program Controlled
/com,****************************************************
/com,******************* SOLVE FOR LS 1 OF 1 ****************
/com,**** Set Direct FE , Displacements ****
d,_CM3166U,ux,0.
d,_CM3166U,uy,0.
d,_CM3166U,uz,0.
/com,**** Set Direct FE , Displacements ****
d,_CM3168U,uy,0.
d,_CM3168U,uz,0.
/com,**** Set Direct FE , Displacements ****
d,_CM3170U,uz,0.
/nopr
/gopr
autots,off                 ! User turned off automatic time stepping
deltim,0.1,0.1,0.1
time,1.1
outres,erase
outres,all,none
outres,nsol,all,
outres,rsol,all
outres,etmp,all
outres,misc,all,
lnsr,on                    ! Line search turned ON by user
nldiag,nrre,on,2
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!   These commands may supersede command settings set by Workbench.

!   Active UNIT system in Workbench when this object was created:  Metric (mm, kg, N, s, mV, mA)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.


NLGEOM,ON
!NROPT,ADAPT
PRED,OFF

!, U, , 0.5, ,
!CNVTOL, F, , 0.1, ,
!SHPP, OFF

NEQIT,50

KBC,1

OUTRES,SVAR,ALL

INTGPTS_CNT=8
*GET,NODE_CNT,NODE,,COUNT   !NODE_CNT=23556
*GET,ELEM_CNT,ELEM,,COUNT   !ELEM_CNT=18750

*GET,MY_THREAD_SMP,ACTIVE,0,NPROC,CURR
*GET,MY_THREAD_DMP,ACTIVE,0,NUMCPU

!Compute the normal direction of the Surface Nodes, otherwise it has to be defines
MY_COMP_NORMAL=0 
!Debug the USSFIN subroutine with export all datas in each step
MY_DEBUG_USSFIN=0
MY_OUTPUT_USSFIN=10  !If =0 -> no Output. >0 -> Output and Print rate

!Debug Gaußpoint output
DEBUG_SID=0

!Export Element ID
CMSEL,S,Expo_Temp_Elem
*GET,MY_EXP_ELEM_ID,ELEM,0,NUM,MAX

MY_EXPORT_TEMP_USSFIN=1
MY_EXPORT_FOLDER = '120W_Mesh_Dependence'

ALLSEL
! ****** End   Command Snippet ******
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!   These commands may supersede command settings set by Workbench.

!   Active UNIT system in Workbench when this object was created:  Metric (mm, kg, N, s, mV, mA)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.


!Parameter for Creating the NEM Data

WRITE_PATH='C:\Work\Debug-Files'!'/bigwork/nhkbtoru/ANSYS_Export'!
WRITE_FILE='PRJ11_TestCube'

SEARCH_RADIUS=-0.1   !Wenn negativ, dann geschätzte Radius
NEIGHBOR_CNT=30 !Max Neighbores
BETA_STAR=2E-1!0.00008!0.00015! ! Weightening of the W-Matrix in the exponential function
WMAT_THRESHOLD=1E-8    !Weightening cut factor for the W-Matrix
ASSEMBLE_KEY=1 !sAssembKey = 1: Laplace, 2: Dx+Dy+Dz 3 or all other: All
DEBUG_KEY=0     !=1 Debug the Read in Datas
                        ! =2 After get neighbor function
                        ! =3 Debug for sID=1 the DMat local, write files to EXPORT_PATH 
                        ! =4 Debug the automatic search Radius and GetNhgb function
                        ! =5 Debug the Export Matrix
                        ! =6 Debug all Dmat for every point
                        ! =7 Debug the Get Neighbor Function for sID1 and this sIDNode
                        ! =8 Debug the vectors from APDL to Usermat (like Normal directions, Surface Node list,..)
                        ! =9 Debug if Dmat value is NAN
                        ! =100 Debug All
                        ! =201 Testfunction phi=1/6(x^2+y^2+z^2)
                        ! =202 Testfunction phi=Cos(x*2PI)*Cos(y*2PI)*Cos(z*2PI)
                        ! =203 Testfunction phi=sin(x*PI)
                        ! =204 Testfunction phi =EXP(2*x)
                        ! =205 Testfunction gradient in x-direction phi=Cos(x*2PI) -> Check whether the boundary is zero
                        
MY_NEM_ACTIVE=1          !1= CREATE, 0=READ

!Get count of all Surface Nodes
CMSEL,S,AllSurfaceNodes
*GET,NODE_CNT_SURF,NODE,0,COUNT
*VGET,NODE_SURF_LIST,NODE,,NLIST

ALLSEl,ALL
                

*GET,NODE_CNT,NODE,0,COUNT
*DIM,VGLBNODENORMX,ARRAY,NODE_CNT,1
*DIM,VGLBNODENORMY,ARRAY,NODE_CNT,1
*DIM,VGLBNODENORMZ,ARRAY,NODE_CNT,1
*DIM,VGLNODEICVALUES,ARRAY,NODE_CNT,1
*DIM,VGBOUNDARYNODE,ARRAY,NODE_CNT,1


!X-Direction
CMSEL,S,Xmin
*GET,selected_node_count_,NODE,,COUNT
*VGET,node_list_,NODE,,NLIST
*DO,pp,1,selected_node_count_,1
	VGLBNODENORMX(node_list_(pp,1),1)=-1
	VGBOUNDARYNODE(node_list_(pp,1),1)=1
*ENDDO
*DEL,,PRM_

CMSEL,S,Xmax
*GET,selected_node_count_,NODE,,COUNT
*VGET,node_list_,NODE,,NLIST
*DO,pp,1,selected_node_count_,1
	VGLBNODENORMX(node_list_(pp),1)=1
	VGBOUNDARYNODE(node_list_(pp,1),1)=1
*ENDDO
*DEL,,PRM_

!Y-Direction
CMSEL,S,Ymin
*GET,selected_node_count_,NODE,,COUNT
*VGET,node_list_,NODE,,NLIST
*DO,pp,1,selected_node_count_,1
	VGLBNODENORMY(node_list_(pp),1)=-1
	VGBOUNDARYNODE(node_list_(pp,1),1)=1
*ENDDO
*DEL,,PRM_

CMSEL,S,Ymax
*GET,selected_node_count_,NODE,,COUNT
*VGET,node_list_,NODE,,NLIST
*DO,pp,1,selected_node_count_,1
	VGLBNODENORMY(node_list_(pp),1)=1
	VGBOUNDARYNODE(node_list_(pp,1),1)=1
*ENDDO
*DEL,,PRM_

!Z-Direction
CMSEL,S,Zmin
*GET,selected_node_count_,NODE,,COUNT
*VGET,node_list_,NODE,,NLIST
*DO,pp,1,selected_node_count_,1
	VGLBNODENORMZ(node_list_(pp),1)=-1
	VGBOUNDARYNODE(node_list_(pp,1),1)=1
*ENDDO
*DEL,,PRM_

CMSEL,S,Zmax
*GET,selected_node_count_,NODE,,COUNT
*VGET,node_list_,NODE,,NLIST
*DO,pp,1,selected_node_count_,1
	VGLBNODENORMZ(node_list_(pp),1)=1
	VGBOUNDARYNODE(node_list_(pp,1),1)=1
*ENDDO
*DEL,,PRM_

*DO,pp,1,NODE_CNT_SURF
    Betrag=SQRT(VGLBNODENORMX(NODE_SURF_LIST(pp,1),1)**2+VGLBNODENORMY(NODE_SURF_LIST(pp,1),1)**2+VGLBNODENORMZ(NODE_SURF_LIST(pp,1),1)**2)
    VGLBNODENORMX(NODE_SURF_LIST(pp,1),1)=VGLBNODENORMX(NODE_SURF_LIST(pp,1),1)/Betrag
    VGLBNODENORMY(NODE_SURF_LIST(pp,1),1)=VGLBNODENORMY(NODE_SURF_LIST(pp,1),1)/Betrag
    VGLBNODENORMZ(NODE_SURF_LIST(pp,1),1)=VGLBNODENORMZ(NODE_SURF_LIST(pp,1),1)/Betrag
*ENDDO

ALLSEL,ALL

! ****** End   Command Snippet ******

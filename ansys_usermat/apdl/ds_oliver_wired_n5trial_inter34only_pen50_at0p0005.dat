!  Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!  These commands may supersede command settings set by Workbench.

!  Active UNIT system in Workbench when this object was created:  Metric (tonne, mm, N, s, V, A)
!  NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!         See Solving Units in the help system for more information.

!Material Data
YOUNG_BIO = 1000    ![UNIT]
YOUNG_VOID = 1      ![UNIT]
POISSON_BIO = 0.3   ![-]
POISSON_VOID = 0.3  ![-]

!starting value
!biofilm (0 or 1)
MY_BIOSTART1 = 1.0
MY_BIOSTART2 = 0.0
!nutrients
MY_NUTSTART1 = 1.0
MY_NUTSTART2 = 0.0

!Beta for biofilm species
MY_BETA1 = 0.0001 
MY_BETA2 = 0.05 !not in use for mono-species

!Diffusion for nutrients (1,2)
MY_DIFF1 = 1
MY_DIFF2 = 1 !not in use for mono-nutrients

!nonlocal coefficients (k_alpha)
K_LOCAL1 = 0.01
K_LOCAL2 = 0.01 !not in use for mono-species

!coefficients Monod equation %nutrient%%species%
MAX_GROWTH11 = 100
MAX_GROWTH21 = 0 !not in use for mono-species
MAX_GROWTH12 = 0.1
MAX_GROWTH22 = 0 !not in use for mono-species

HALF_VELO11 = 0.1
HALF_VELO21 = 0.1 !not in use for mono-species
HALF_VELO12 = 0.1
HALF_VELO22 = 0.1 !not in use for mono-species

!weight for orientation function %nutrient%%species%
ORI_WEIGHT11 = 1 
ORI_WEIGHT21 = 0
ORI_WEIGHT12 = 1
ORI_WEIGHT22 = 0

!consumption parameter CONSUMTION%nutrient%%species%
!nutrient1
CONSUMPTION11 = 0.5
CONSUMPTION12 = 0 !not in use for mono-species

!nutrient2
CONSUMPTION21 = 0 !not in use for mono-nutrients
CONSUMPTION22 = 0.5 !not in use for mono-species and mono-nutrients

!Interaction constant INTERACTION%X%%Y% How species %X% reacts to species %Y%
INTERACTION12 = 0 !not in use for mono-species
INTERACTION21 = 0 !not in use for mono-species

!Penalty Parameter
PENALTY1 = 50

!n=3 growth-term trial (N3_GROWTH_TRIAL.md): species 3 mirrors species 1's
!real Monod-kinetics constants, uncoupled (no INTERACTION1x/x1 term yet).
!Seeded via species 1's own element region (ELEM_LIST_BIO1) in Fortran --
!no separate ELEM_LIST_BIO3 deck parameter for this trial.
MY_BIOSTART3 = 1.0
MY_BETA3 = 0.0001
K_LOCAL3 = 0.01
MAX_GROWTH13 = 100
MAX_GROWTH23 = 0
HALF_VELO13 = 0.1
HALF_VELO23 = 0.1
ORI_WEIGHT13 = 1
ORI_WEIGHT23 = 0

!n=4 extension (N3_GROWTH_TRIAL.md sec. n=4/n=5 strategy): species 4
!mirrors species 3's pattern exactly, uncoupled, seeded via species 1's
!element region (no separate ELEM_LIST_BIO4 deck parameter).
MY_BIOSTART4 = 1.0
MY_BETA4 = 0.0001
K_LOCAL4 = 0.01
MAX_GROWTH14 = 100
MAX_GROWTH24 = 0
HALF_VELO14 = 0.1
HALF_VELO24 = 0.1
ORI_WEIGHT14 = 1
ORI_WEIGHT24 = 0

!n=5 extension (N3_GROWTH_TRIAL.md sec. n=4/n=5 strategy): species 5
!mirrors species 3/4's pattern exactly, uncoupled, seeded via species 1's
!element region (no separate ELEM_LIST_BIO5 deck parameter).
MY_BIOSTART5 = 1.0
MY_BETA5 = 0.0001
K_LOCAL5 = 0.01
MAX_GROWTH15 = 100
MAX_GROWTH25 = 0
HALF_VELO15 = 0.1
HALF_VELO25 = 0.1
ORI_WEIGHT15 = 1
ORI_WEIGHT25 = 0

!Full n=5 pairwise interaction (N3_GROWTH_TRIAL.md sec. interaction
!terms), default OFF (0) to preserve prior verified behavior.
INTERACTION13 = 0
INTERACTION14 = 0
INTERACTION15 = 0
INTERACTION23 = 0
INTERACTION24 = 0
INTERACTION25 = 0
INTERACTION31 = 0
INTERACTION32 = 0
INTERACTION34 = 0.0005
INTERACTION35 = 0
INTERACTION41 = 0
INTERACTION42 = 0
INTERACTION43 = 0.0005
INTERACTION45 = 0
INTERACTION51 = 0
INTERACTION52 = 0
INTERACTION53 = 0
INTERACTION54 = 0


*DIM,V_YOUNG,ARRY,4,1
V_YOUNG(1)=21.0E4     !STAHL [MPa]
V_YOUNG(2)=7.3E4     !Amorph [MPa]
V_YOUNG(3)=7.3E0     !Liquid [MPa]
V_YOUNG(4)=1.0E-1     !Air Factor of the main diagonal entries [MPa]
*DIM,V_POISSON,ARRY,4,1
V_POISSON(1)=0.3      !STAHL [/]
V_POISSON(2)=0.17      !Amorph [/]
V_POISSON(3)=0.25      !Liquid [/]
V_POISSON(4)=0.05      !Air [/]

*DIM,V_DENSITY,ARRY,4,1
V_DENSITY(1)=7.85E-09  !STAHL [tonne/mm^3]
V_DENSITY(2)=2.2E-09  !Amorph [tonne/mm^3]
V_DENSITY(3)=2.0E-09  !Liquid [tonne/mm^3]
V_DENSITY(4)=1.16E-12 !Air [tonne/mm^3]

*DIM,V_TH_EXPANSION,ARRY,4,1
V_TH_EXPANSION(1)=5.7E-07   !STAHL [1/K]
V_TH_EXPANSION(2)=5.7E-07   !Amorph [1/K]
V_TH_EXPANSION(3)=5.7E-07    !Liquid [1/K]
V_TH_EXPANSION(4)=0         !Air [1/K]

*DIM,V_HEAT_CAPACITY,ARRY,4,1
V_HEAT_CAPACITY(1)=434000000	!STAHL [N*mm/(tonne)]
V_HEAT_CAPACITY(2)=7.4E8!7.4E8	!Amorph [N*mm/(tonne*K)]
V_HEAT_CAPACITY(3)=1.427E9	!Liquid [N*mm/(tonne*K)]
V_HEAT_CAPACITY(4)=1!1.021E9	!Air [N*mm/(tonne*K)]

*DIM,V_TH_CONDUCTIVITY,ARRY,4,1
V_TH_CONDUCTIVITY(1)=60.5		    !STAHL [mW/(mm*K)]
V_TH_CONDUCTIVITY(2)=1.1	    !Amorph [mW/(mm*K)]
V_TH_CONDUCTIVITY(3)=1.1		    !Liquid [mW/(mm*K)]
V_TH_CONDUCTIVITY(4)=1E-6!0.02582	!Air [mW/(mm*K)]

*DIM,V_TH_EMISSION,ARRY,4,1 !Radiation
!Werte laut Perplexity
V_TH_EMISSION(1)=0   
V_TH_EMISSION(2)=0   !0.9
V_TH_EMISSION(3)=0  !0.95  
V_TH_EMISSION(4)=0	

MY_CONST_MAT_PROP=1 !1-> Use Constant Cp and TH_Conductivity, 0-> Calcualte CP and TH_Conductivity in dependence of temperature

*DIM,V_LAMBDA_INIT,ARRAY,3
V_LAMBDA_INIT(1)=1    !Crystallien
V_LAMBDA_INIT(2)=0     !Amorph
V_LAMBDA_INIT(3)=0     !Liquid


MY_LATENTHEAT=1.5E11   !Latent Heat [(N*mm)/tonne]
MY_OFFSET=10 !10      !Caloric energy offset [(N*mm)/tonne]

MY_TEMP_INIT=100+273.15
MY_TEMP_REF=22+273.15          !Reference Temperature
MY_TEMP_MELT=2003.15         !Melting Temüerature
MY_TEMP_GLASS_TRANSITION=1683.15  !Glass transition temperature

MY_A_AMORPH=1E-8
MY_B_AMORPH=2500
MY_T0_AMORPH=1173.15!MY_TEMP_GLASS_TRANSITION-350
MY_A_CRYSTAL=1E-4
MY_B_CRYSTAL=10
MY_TRANGE_CRYSTAL=1
MY_MAX_ETA=1E14 !Both
MY_MIN_ETA=1E-8  !Mechanical
MY_LAMBDA_ETA=1E-8  !Only for Lambda Amorphous and Liquid   

MY_ETA_MECH_1=-23
MY_ETA_MECH_2= 30000 

*DIM,MY_V_TEST_SCALE_CP,ARRAY,4
MY_V_TEST_SCALE_CP(1)=1     !Crystallien
MY_V_TEST_SCALE_CP(2)=1    !Amorph
MY_V_TEST_SCALE_CP(3)=1    !Liquid
MY_V_TEST_SCALE_CP(4)=1     !Air

*DIM,MY_V_TEST_SCALE_TH,ARRAY,4
MY_V_TEST_SCALE_TH(1)=1    !Crystallien
MY_V_TEST_SCALE_TH(2)=1    !Amorph
MY_V_TEST_SCALE_TH(3)=1    !Liquid
MY_V_TEST_SCALE_TH(4)=1     !Air


! ****** End   Command Snippet ******
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!   These commands may supersede command settings set by Workbench.

!   Active UNIT system in Workbench when this object was created:  Metric (mm, kg, N, s, mV, mA)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.

MY_CYKLUSCNT=3 !Should be the same like the load steps or greater

!Numerical parameter for the phase transformation
MY_NP_THRESHOLD=1E-8 ![Mpa]  !Threshold for the dissipative energy
MY_NP_PENALTY=1E-10       !Penalty parameter for th barrier/penalty function in the free energy


!USSFIN settings
MY_USSFIN_DT_MIN=1E-1
MY_USSFIN_DT_MAX=1E-1   !Activ by Temperature > 0.9* MY_TEMP_GLASS_TRANSITION :AND: < 1.1* MY_TEMP_MELT

*DIM,MY_V_DT,ARRAY,MY_CYKLUSCNT,1
MY_V_DT(1)=1E-1
MY_V_DT(2)=1E-1


*DIM,MY_V_HEAT,ARRY,MY_CYKLUSCNT,1  !Laser Power
MY_V_HEAT(1)=0!mW   !P=200W*0.8% Absorption        !1.8E4
MY_V_HEAT(2)=0!-5E3

MY_HEAT_CONV_COEFF=1 !0.5 !Natürliche Konvektion 0,005…0,025 mW/(mm2·K)


*DIM,MY_REFLECTIONS_LIMIT,ARRY,2,1  !Reflection Limits for the Slope calculation
*IF,MY_CONST_MAT_PROP,EQ,0,THEN
   MY_REFLECTIONS_LIMIT(1)=0.2!COLD at 295K
   MY_REFLECTIONS_LIMIT(2)=0.062907035 !Hot at melt temp
   MY_REFLECTION=0.0
*ELSE
    MY_REFLECTIONS_LIMIT(1)=0 !COLD at 295K
    MY_REFLECTIONS_LIMIT(2)=0 !Hot at melt temp
    MY_REFLECTION=0.05!0.15 !Frensel Reflection Law for SiO2 ~10-20%
*ENDIF
MY_HEAT_EXPONENT=2   !Is the n in: (n+1) * |Grad phi| *(1-phi)^n



!Laser Beam source
    !!!!Movement has to be in X-Y direction
    !!!! Hight has to be in Z-Direction
    
    S_LASER_SPIRAL_ACTIVE=0 !0>> Linear Movement 1>> for Spiral Movement laser >>2 Radius movement 
    S_LASER_SPIRAL_IMPROV=0.1   !Laser improvement for the spiral movement
    

    
    *DIM,MY_M_LASER_POS,ARRAY,MY_CYKLUSCNT,3   !Columns 1: X-Pos|| 2:Y-Pos || 3:Z-Pos
    !First Line
    MY_M_LASER_POS(1,1)=0!-1E-01
    MY_M_LASER_POS(1,2)=0
    MY_M_LASER_POS(1,3)=0
    
    !Second Line
    MY_M_LASER_POS(2,1)=0!-1E-01
    MY_M_LASER_POS(2,2)=0
    MY_M_LASER_POS(2,3)=0
    

    
    *DIM,MY_M_LASER_VELO,ARRAY,MY_CYKLUSCNT,3  !Columns 1: X-Velo|| 2:Y-Velo || 3:Z-Velo
    !First Line
    MY_M_LASER_VELO(1,1)=0
    MY_M_LASER_VELO(1,2)=0
    MY_M_LASER_VELO(1,3)=0
        
    !Second Line
    MY_M_LASER_VELO(2,1)=0!1.66
    MY_M_LASER_VELO(2,2)=0
    MY_M_LASER_VELO(2,3)=0
    
    MY_LASER_RADIUS=2.691847861
    MY_LASER_DEEPTH=0.05    !Keinen Einfluss mehr -> Obsulate
        
    !Mass source
    MY_LAYER_RADIUS=0.0
    MY_LAYER_THICKNESS=0.0
    
    !Measurement with Pyrometer
    MY_RADIUS_PYROMETER=0.5
    !Optischer Absorptionskoeffizient von Glas (muss kalibriert werden, z.B. alpha = 2.0 bis 10.0 mm^-1)
    MY_ALPHA_PYROMETER=2
    
    *DIM,MY_V_PYRO_CENTER,ARRAY,3,1
    MY_V_PYRO_CENTER(1,1)=0      !X-Coordinate
    MY_V_PYRO_CENTER(2,1)=0     !Y-Coordinate
    MY_V_PYRO_CENTER(3,1)=0     !Z-Coordinate
    
    *DIM,MY_V_PYRO_DEPTH_TOL,ARRAY,2,1
    MY_V_PYRO_DEPTH_TOL(1,1)=0      !Plus from the measurement plane
    MY_V_PYRO_DEPTH_TOL(2,1)=0.2    !Minus from the measurement plane

    
!Phi threshold. If masssource larger than threshold >> phi=1, otherwise >>phi=0
MY_PHI_DISCONT=0.2
    
    
!Identivator Phase

ALLSEL,ALL
CMSEL,S,IC_Phi_Elem
*VGET,MY_IC_PHI_LIST_ELEM,ELEM,,ELIST
*GET,MY_IC_PHI_COUNT_ELEM,ELEM,0,COUNT

ALLSEL,ALL

CMSEL,S,IC_Phi_Node
*VGET,MY_IC_PHI_LIST_NODE,NODE,,NLIST
*GET,MY_IC_PHI_COUNT_NODE,NODE,0,COUNT

ALLSEL,ALL

CMSEL,S,HeatUp_Elem
*VGET,MY_HEAT_UP_ELEM_LIST,ELEM,,ELIST
*GET,MY_HEAT_UP_CNT,ELEM,0,COUNT

ALLSEL,ALL

CMSEL,S,nutrient1
*GET,ELEM_CNT_NUT1,ELEM,0,COUNT
*VGET,ELEM_LIST_NUT1,ELEM,,ELIST

ALLSEl,ALL

CMSEL,S,nutrient2
*GET,ELEM_CNT_NUT2,ELEM,0,COUNT
*VGET,ELEM_LIST_NUT2,ELEM,,ELIST

ALLSEl,ALL

CMSEL,S,biofilm1
*GET,ELEM_CNT_BIO1,ELEM,0,COUNT
*VGET,ELEM_LIST_BIO1,ELEM,,ELIST

ALLSEl,ALL

CMSEL,S,biofilm2
*GET,ELEM_CNT_BIO2,ELEM,0,COUNT
*VGET,ELEM_LIST_BIO2,ELEM,,ELIST

ALLSEl,ALL

